{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@quiz/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@quiz/auth/*": [
        "../../packages/auth/src/*"
      ],
      "@quiz/config": [
        "../../packages/config/envPaths.ts"
      ],
      "@quiz/config/*": [
        "../../packages/config/*"
      ],
      "@quiz/types": [
        "../../packages/types/src/index.ts"
      ],
      "@quiz/types/*": [
        "../../packages/types/src/*"
      ],
      "@quiz/db-people": [
        "../../packages/db-people/src/index.ts"
      ],
      "@quiz/db-people/*": [
        "../../packages/db-people/src/*"
      ],
      "@quiz/db-payment": [
        "../../packages/db-payment/src/index.ts"
      ],
      "@quiz/db-payment/*": [
        "../../packages/db-payment/src/*"
      ],
      "@quiz/db-placement": [
        "../../packages/db-placement/src/index.ts"
      ],
      "@quiz/db-placement/*": [
        "../../packages/db-placement/src/*"
      ]
    },
    "jsx": "preserve",
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../src/**/*.ts",
    "../../src/**/*.tsx",
    "../../packages/types/src/globals/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright.config.ts",
    "*.config.js",
    "*.config.mjs",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test",
    "src/__tests__",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
