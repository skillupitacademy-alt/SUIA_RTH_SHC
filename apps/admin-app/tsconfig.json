{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@quiz/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@web-tests/*": [
        "../web-app/tests/e2e/*"
      ],
      "@quiz/api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@quiz/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@quiz/auth/*": [
        "../../packages/auth/src/*"
      ],
      "@quiz/events": [
        "../../packages/events/src/index.ts"
      ],
      "@quiz/events/*": [
        "../../packages/events/src/*"
      ],
      "@quiz/db-tutorial": [
        "../../packages/db-tutorial/src/index.ts"
      ],
      "@quiz/db-tutorial/*": [
        "../../packages/db-tutorial/src/*"
      ],
      "@quiz/db/*": [
        "../../packages/db/src/*"
      ],
      "@quiz/config": [
        "../../packages/config/envPaths.ts"
      ],
      "@quiz/config/*": [
        "../../packages/config/*"
      ],
      "@quiz/types": [
        "../../packages/types/src/index.ts"
      ],
      "@quiz/types/*": [
        "../../packages/types/src/*"
      ],
      "@quiz/observability": [
        "../../packages/observability/src/index.ts"
      ]
    },
    "jsx": "preserve",
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/types/src/globals/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright.config.ts",
    "*.config.js",
    "*.config.mjs",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test",
    "src/__tests__",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
