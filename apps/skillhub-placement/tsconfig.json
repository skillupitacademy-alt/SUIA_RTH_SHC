{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@quiz/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@quiz/auth/*": [
        "../../packages/auth/src/*"
      ],
      "@quiz/db-placement": [
        "../../packages/db-placement/src/index.ts"
      ],
      "@quiz/db-placement/*": [
        "../../packages/db-placement/src/*"
      ]
    },
    "jsx": "preserve",
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "*.config.js",
    "*.config.mjs"
  ]
}
