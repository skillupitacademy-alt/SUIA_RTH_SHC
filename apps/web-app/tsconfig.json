{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@quiz/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@quiz/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@quiz/db": [
        "../../packages/db/src/index.ts"
      ]
    },
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "*.config.js",
    "*.config.mjs"
  ]
}