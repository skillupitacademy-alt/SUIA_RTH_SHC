{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@admin-tests/*": [
        "../admin-app/tests/e2e/*"
      ],
      "@quiz/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@quiz/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@quiz/api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@quiz/config": [
        "../../packages/config/envPaths.ts"
      ],
      "@quiz/config/*": [
        "../../packages/config/*"
      ],
      "@quiz/db": [
        "../../packages/db/src/index.ts"
      ],
      "@quiz/db/*": [
        "../../packages/db/src/*"
      ],
      "@quiz/types": [
        "../../packages/types/src/index.ts"
      ],
      "@quiz/types/*": [
        "../../packages/types/src/*"
      ]
    },
    "jsx": "preserve",
    "types": [
      "bcryptjs"
    ],
    "typeRoots": [
      "../../types",
      "../../node_modules/@types"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "*.config.js",
    "*.config.mjs",
    "*.config.ts"
  ]
}