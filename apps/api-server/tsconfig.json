{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@quiz/auth": [
                "../../packages/auth/src/index.ts"
            ],
            "@quiz/auth/*": [
                "../../packages/auth/src/*"
            ],
            "@quiz/api-client": [
                "../../packages/api-client/src/index.ts"
            ],
            "@quiz/api-client/*": [
                "../../packages/api-client/src/*"
            ],
            "@quiz/db-tutorial": [
                "../../packages/db-tutorial/src/index.ts"
            ],
            "@quiz/db-tutorial/*": [
                "../../packages/db-tutorial/src/*"
            ],
            "@quiz/db-people": [
                "../../packages/db-people/src/index.ts"
            ],
            "@quiz/db-people/*": [
                "../../packages/db-people/src/*"
            ],
            "@quiz/db": [
                "../../packages/db/src/index.ts"
            ],
            "@quiz/db/*": [
                "../../packages/db/src/*"
            ],
            "@quiz/events": [
                "../../packages/events/src/index.ts"
            ],
            "@quiz/events/*": [
                "../../packages/events/src/*"
            ],
            "@quiz/config": [
                "../../packages/config/envPaths.ts"
            ],
            "@quiz/config/*": [
                "../../packages/config/*"
            ],
            "@quiz/types": [
                "../../packages/types/src/index.ts"
            ],
            "@quiz/types/*": [
                "../../packages/types/src/*"
            ],
            "@quiz/observability": [
                "../../packages/observability/src/index.ts"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "*.config.js",
        "*.config.mjs",
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/test",
        "src/__tests__",
        "src/__test-utils__",
        "**/__tests__",
        "vitest.config.ts",
        "vitest.setup.ts",
        "scripts"
    ]
}
