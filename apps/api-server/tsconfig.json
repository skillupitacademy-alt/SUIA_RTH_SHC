{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@quiz/api-client/*": [
                "../../packages/api-client/src/*"
            ],
            "@quiz/db/*": [
                "../../packages/db/src/*"
            ],
            "@quiz/config": [
                "../../packages/config/envPaths.ts"
            ],
            "@quiz/config/*": [
                "../../packages/config/*"
            ],
            "@quiz/types": [
                "../../packages/types/src/index.ts"
            ],
            "@quiz/types/*": [
                "../../packages/types/src/*"
            ],
            "@quiz/observability": [
                "../../packages/observability/src/index.ts"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "*.config.js",
        "*.config.mjs",
        "**/*.test.ts",
        "src/__test-utils__",
        "vitest.config.ts",
        "vitest.setup.ts"
    ]
}