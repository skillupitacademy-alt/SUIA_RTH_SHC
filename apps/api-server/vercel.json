{
    "crons": [
        {
            "path": "/api/cron/cleanup-reports",
            "schedule": "0 0 * * *"
        }
    ],
    "headers": [
        {
            "source": "/api/generate-report",
            "headers": [
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        }
    ],
    "functions": {
        "api/*": {
            "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
        }
    }
}
