{
    "crons": [
        {
            "path": "/api/cron/cleanup-reports",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/pdf-health",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/api/debug/sweep-stuck-reports",
            "schedule": "0 2 * * *"
        }
    ],
    "functions": {
        "src/app/api/generate-report/route.ts": {
            "maxDuration": 60,
            "includeFiles": "../../node_modules/@sparticuz/chromium/bin/**"
        },
        "src/app/api/cron/pdf-health/route.ts": {
            "maxDuration": 60,
            "includeFiles": "../../node_modules/@sparticuz/chromium/bin/**"
        },
        "src/app/api/cron/process-report-jobs/route.ts": {
            "maxDuration": 60,
            "includeFiles": "../../node_modules/@sparticuz/chromium/bin/**"
        }
    },
    "framework": "nextjs",
    "buildCommand": "pnpm --filter @quiz/api-server build",
    "installCommand": "pnpm install --frozen-lockfile",
    "outputDirectory": ".next"
}
