{
    "extends": [
        "next/core-web-vitals",
        "next/typescript"
    ],
    "plugins": [
        "security"
    ],
    "rules": {
        "react/no-danger": "error",
        "no-eval": "error",
        "no-implied-eval": "error",
        "no-new-func": "error",
        "security/detect-object-injection": "warn",
        "security/detect-non-literal-require": "error"
    }
}