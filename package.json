{
    "name": "quiz-platform",
    "version": "0.0.0",
    "private": true,
    "description": "A modern quiz platform monorepo",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "turbo run test",
