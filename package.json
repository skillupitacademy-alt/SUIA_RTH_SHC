{
    "name":  "quiz-platform",
    "version":  "0.0.0",
    "private":  true,
    "description":  "A modern quiz platform monorepo",
    "workspaces":  [
                       "apps/*",
                       "apps/realtutorialhub-admin",
                       "apps/realtutorialhub-quiz",
                       "apps/skillup-web",
                       "apps/skillup-admin",
                       "apps/faculty-app",
                       "apps/skillhubcore-admin",
                       "packages/*",
                       "services/*"
                   ],
    "lint-staged":  {
                        "apps/**/*.{ts,tsx,js,jsx}":  [
                                                          "eslint --no-ignore --max-warnings=0 --fix"
                                                      ],
                        "packages/**/*.{ts,tsx,js,jsx}":  [
                                                              "eslint --no-ignore --max-warnings=0 --fix"
                                                          ]
                    },
    "scripts":  {
                    "dev":  "turbo run dev",
                    "build":  "turbo run build",
                    "build:all":  "turbo run build --filter=@quiz/realtutorialhub-quiz --filter=@quiz/realtutorialhub-admin --filter=@quiz/api-server --filter=@quiz/realtutorialhub-web --filter=@quiz/skillhubcore-service --filter=@quiz/api-gateway --filter=@quiz/db-people --filter=@quiz/skillup-web --filter=@quiz/skillup-admin --filter=@quiz/faculty-app --filter=@quiz/skillhubcore-admin --filter=@quiz/skillhub-placement",
                    "analyze:all":  "cross-env ANALYZE=true turbo run build --filter=@quiz/realtutorialhub-quiz --filter=@quiz/realtutorialhub-admin --filter=@quiz/realtutorialhub-web",
                    "lint":  "turbo run lint -- --max-warnings=0",
                    "lint:all":  "turbo run lint",
                    "test":  "turbo run test",
                    "test:watch":  "vitest",
                    "test:ui":  "vitest --ui",
                    "test:all":  "pnpm --recursive run test",
                    "test:load":  "k6 run scripts/load/smoke.js",
                    "k6:exam":  "k6 run k6/exam-flow.js",
                    "k6:auth":  "k6 run k6/auth-flow.js",
                    "k6:admin":  "k6 run k6/admin-flow.js",
                    "k6:all":  "k6 run k6/exam-flow.js && k6 run k6/auth-flow.js && k6 run k6/admin-flow.js",
                    "validate:gateway":  "node scripts/validate-gateway.mjs",
                    "validate:gateway:live":  "node scripts/validate-gateway.mjs --live",
                    "seed:skillup:test-credentials":  "node scripts/seed-skillup-test-credentials.js",
                    "seed:skillup:people":  "pnpm --filter @quiz/db-people db:seed:skillup",
                    "seed:rth:looping-demo":  "tsx scripts/seed-rth-looping-demo.ts",
                    "seed:test-users":  "tsx scripts/check-test-users.ts",
                    "seed:quiz-test-users":  "node scripts/seed-quiz-test-users-sql.js",
                    "db-payment:seed:skillup":  "pnpm --filter @quiz/db-payment db:seed:skillup",
                    "db-payment:migrate":  "pnpm --filter @quiz/db-payment db:migrate",
                    "db-placement:seed:skillup":  "pnpm --filter @quiz/db-placement db:seed:skillup",
                    "db-placement:migrate":  "pnpm --filter @quiz/db-placement db:migrate",
                    "type-check":  "turbo run type-check",
                    "typecheck:all":  "turbo run type-check --filter=@quiz/realtutorialhub-quiz --filter=@quiz/realtutorialhub-admin --filter=@quiz/api-server --filter=@quiz/realtutorialhub-web --filter=@quiz/skillhubcore-service --filter=@quiz/api-gateway --filter=@quiz/db-people --filter=@quiz/skillup-web --filter=@quiz/skillup-admin --filter=@quiz/faculty-app --filter=@quiz/skillhubcore-admin --filter=@quiz/skillhub-placement",
                    "audit:csrf-cross-subdomain": "node scripts/audit-csrf-cross-subdomain.mjs",
                    "validate:cloudrun-coverage": "node scripts/verify-cloudrun-coverage.mjs",
                    "ci":  "pnpm lint:all \u0026\u0026 pnpm typecheck:all \u0026\u0026 pnpm build:all",
                    "clean":  "turbo run clean \u0026\u0026 rm -rf node_modules",
                    "lighthouse:web": "cd apps/realtutorialhub-quiz && npx lhci autorun",
                    "lighthouse:admin": "cd apps/realtutorialhub-admin && npx lhci autorun",
                    "lighthouse:all": "pnpm lighthouse:web && pnpm lighthouse:admin",
                    "prepare":  "echo \"husky prepare temporarily disabled; set scripts.prepare=\\\"husky\\\" to re-enable\""
                },
    "devDependencies":  {
                            "@axe-core/playwright":  "^4.11.1",
                            "@playwright/test":  "^1.49.1",
                            "@quiz/db":  "workspace:*",
                            "@quiz/eslint-config":  "workspace:^",
                            "@testing-library/dom":  "^10.4.1",
                            "@testing-library/jest-dom":  "^6.9.1",
                            "@testing-library/react":  "^16.3.2",
                            "@testing-library/user-event":  "^14.6.1",
                            "@neondatabase/serverless":  "^0.10.4",
                            "@next/bundle-analyzer":  "^16.1.6",
                            "@types/bcrypt":  "^5.0.2",
                            "@types/bcryptjs":  "^3.0.0",
                            "@types/jsonwebtoken":  "^9.0.8",
                            "@types/node":  "^25.0.10",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "@types/ws":  "^8.18.1",
                            "@vitest/coverage-v8":  "^4.0.18",
                            "@vitest/ui":  "^4.0.18",
                            "cross-env":  "^10.1.0",
                            "dotenv":  "^17.2.3",
                            "drizzle-kit":  "^0.31.8",
                            "drizzle-orm":  "^0.45.1",
                            "eslint-plugin-jsx-a11y":  "^6.10.2",
                            "eslint-plugin-react-hooks":  "4.6.2",
                            "eslint-plugin-security":  "^3.0.1",
                            "eslint-plugin-simple-import-sort":  "^12.1.1",
                            "husky":  "^9.1.7",
                            "jsdom":  "^28.1.0",
                            "lint-staged":  "^16.2.7",
                            "next":  "16.1.6",
                            "pg":  "^8.18.0",
                            "pino":  "^10.3.1",
                            "react":  "19.2.4",
                            "react-dom":  "19.2.4",
                            "ts-morph":  "^27.0.2",
                            "typescript":  "^5.7.2",
                            "turbo":  "^2.3.3",
                            "vite-tsconfig-paths":  "^6.1.1",
                            "vitest":  "^4.0.18",
                            "ws":  "^8.19.0",
                            "@upstash/redis":  "^1.36.2",
                            "@upstash/workflow":  "^1.1.1"
                        },
    "packageManager":  "pnpm@9.15.4",
    "engines":  {
                    "node":  "20.x"
                },
    "pnpm": {
        "overrides": {
            "@smithy/types": "4.12.0",
            "@typescript-eslint/eslint-plugin": "^8.0.0",
            "@typescript-eslint/parser": "^8.0.0",
            "@typescript-eslint/utils": "^8.0.0"
        }
    }
}
