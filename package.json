{
    "name": "quiz-platform",
    "version": "0.0.0",
    "private": true,
    "description": "A modern quiz platform monorepo",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "type-check": "turbo run type-check",
        "clean": "turbo run clean && rm -rf node_modules"
    },
    "devDependencies": {
        "turbo": "^2.3.3",
        "typescript": "^5.7.2"
    },
    "packageManager": "npm@10.8.2",
    "engines": {
        "node": "20.x",
        "npm": ">=10.0.0"
    },
    "dependencies": {
        "@neondatabase/serverless": "^0.10.4",
        "drizzle-kit": "^0.30.6",
        "drizzle-orm": "^0.38.4",
        "next": "^16.1.4"
    }
}