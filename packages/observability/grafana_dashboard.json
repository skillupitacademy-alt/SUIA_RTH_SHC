{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": "-- Grafana --",
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "gnetId": null,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "Golden Transactions (Last 24h)",
            "type": "stat",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(rate(quiz_api_start_total[24h]))",
                    "legendFormat": "Exam Starts"
                },
                {
                    "expr": "sum(rate(quiz_api_submit_total{outcome=\"success\"}[24h]))",
                    "legendFormat": "Successful Submissions"
                }
            ]
        },
        {
            "title": "API Latency (p95)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(api_request_duration_ms_bucket[5m])) by (le, route))"
                }
            ]
        },
        {
            "title": "Error Rate (%)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(api_requests_total{outcome=\"failure\"}[5m])) / sum(rate(api_requests_total[5m])) * 100"
                }
            ]
        }
    ],
    "schemaVersion": 30,
    "style": "dark",
    "tags": [
        "quiz-platform",
        "observability"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "title": "@quiz Platform Health",
    "uid": "quiz-health",
    "version": 1
}