{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Objective O2 Block Schema",
  "description": "JSON Schema for ObjectiveBlock Version O2 (Know -> Understand -> Apply cognitive progression).",
  "type": "object",
  "required": ["objectives"],
  "properties": {
    "eyebrow": {
      "type": "string",
      "description": "Optional uppercase category badge label.",
      "default": "LEARNING OBJECTIVES"
    },
    "title": {
      "type": "string",
      "description": "Main heading for the Objective O2 block.",
      "default": "What You Will Learn"
    },
    "introduction": {
      "type": "string",
      "description": "Introductory lead paragraph explaining the Know -> Understand -> Apply progression."
    },
    "stages": {
      "type": "object",
      "description": "Three-tier cognitive progression grouping (Know, Understand, Apply).",
      "properties": {
        "know": { "$ref": "#/definitions/stageConfig" },
        "understand": { "$ref": "#/definitions/stageConfig" },
        "apply": { "$ref": "#/definitions/stageConfig" }
      },
      "additionalProperties": false
    },
    "objectives": {
      "type": "array",
      "description": "List of measurable learning objectives.",
      "items": { "$ref": "#/definitions/objectiveItem" }
    }
  },
  "definitions": {
    "objectiveItem": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "enum": ["know", "understand", "apply"] },
        "verb": { "type": "string" }
      },
      "additionalProperties": true
    },
    "stageConfig": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/definitions/objectiveItem" }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}