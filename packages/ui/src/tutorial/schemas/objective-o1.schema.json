    "title",
    "objectives"
  ],
  "properties": {
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "titleHighlight": {
      "type": "string"
    },
    "introduction": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "verb": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "badge": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "note": {
      "type": "object"
    }
  },
  "additionalProperties": true
}