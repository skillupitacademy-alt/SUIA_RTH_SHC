# =============================================================================
# REAL TUTORIAL HUB (RTH) BRAND CONFIGURATION
# =============================================================================
# This file contains brand-specific configuration for Real Tutorial Hub.
# Used by: realtutorialhub-web, realtutorialhub-admin, realtutorialhub-quiz
# Layer: 2 of 3 (loaded after shared, before service-specific)
# =============================================================================

# =============================================================================
# BRAND IDENTITY
# =============================================================================
BRAND="realtutorialhub"
PLATFORM="realtutorialhub"
NEXT_PUBLIC_BRAND="realtutorialhub"

# =============================================================================
# COOKIE CONFIGURATION
# =============================================================================
COOKIE_DOMAIN=".realtutorialhub.com"
COOKIE_DOMAIN_RTH=".realtutorialhub.com"

# =============================================================================
# PUBLIC URLS (NEXT_PUBLIC_ vars available in browser)
# =============================================================================
NEXT_PUBLIC_SITE_URL="https://user.realtutorialhub.com"
NEXT_PUBLIC_APP_URL="https://user.realtutorialhub.com"
NEXT_PUBLIC_WEB_APP_URL="https://user.realtutorialhub.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.realtutorialhub.com"
NEXT_PUBLIC_API_URL="https://api.realtutorialhub.com/api"
NEXT_PUBLIC_USER_URL_RTH="https://user.realtutorialhub.com"

# Tutorial app (SkillHubCore manages tutorials)
NEXT_PUBLIC_TUTORIAL_APP_URL="https://tutorial.skillhubcore.in"

# =============================================================================
# GATEWAY URLS
# =============================================================================
GATEWAY_URL="https://api.realtutorialhub.com"

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_FROM="Real Tutorial Hub <noreply@mail.realtutorialhub.com>"
EMAIL_FROM_RTH="Real Tutorial Hub <noreply@mail.realtutorialhub.com>"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
ALLOWED_ORIGINS="https://admin.realtutorialhub.com,https://user.realtutorialhub.com,https://quiz.realtutorialhub.com"

# =============================================================================
# EVENT ENDPOINTS (Brand-specific webhooks)
# =============================================================================
TUTORIAL_HELP_REQUEST_TOPIC_URL="https://api.realtutorialhub.com/api/tutorial/faculty/help-requests"
CERTIFICATE_ISSUED_EVENT_URL="https://api.realtutorialhub.com/api/workers/certificate-issued"
