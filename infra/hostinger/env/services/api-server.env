# =============================================================================
# API SERVER SERVICE CONFIGURATION
# =============================================================================
# Service: api-server
# Port: 3000
# Layer: 3 of 3 (loaded last, highest priority)
# =============================================================================

PORT="3000"
SERVICE_NAME="api-server"

# API server is brand-agnostic and handles all brands
# No brand-specific overrides needed

# Private duplicate-question judge. Keep the shared secret value identical to
# env/services/question-judge.env on the VPS.
QUESTION_JUDGE_ENABLED="true"
QUESTION_JUDGE_URL="http://question-judge:8000"
# Set in /opt/platform/env/shared/.env or uncomment here with the same value as
# env/services/question-judge.env.
# QUESTION_JUDGE_SHARED_SECRET=""
