      "health_check_required": true
    },
    "realtutorialhub-quiz": {
      "name": "realtutorialhub-quiz",
      "package_name": "@quiz/realtutorialhub-quiz",
      "source_path": "apps/realtutorialhub-quiz",
      "compose_name": "realtutorialhub-quiz",
      "image_name": "quiz-platform-realtutorialhub-quiz",
      "buildable": true,
      "health_check_required": true
