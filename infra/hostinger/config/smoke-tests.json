{
  "version": "3.1",
  "description": "HTTP smoke tests for deployment validation. Tests run from an ephemeral curl container on the internal Docker network.",
  "runner": {
    "type": "docker",
    "image": "curlimages/curl:8.11.1",
    "network": "quiz_platform_internal"
  },
  "tests": {
    "api-server": {
      "name": "API Server Health",
      "method": "GET",
      "url": "http://api-server:3000/api/health/live",
      "expected_status": 200,
      "timeout_seconds": 10,
      "required": true
    },
    "realtutorialhub-web": {
      "name": "RTH Web Homepage",
      "method": "GET",
      "url": "http://realtutorialhub-web:3003/",
      "expected_status": 200,
      "timeout_seconds": 15,
      "required": true
    },
    "realtutorialhub-quiz": {
      "name": "RTH Quiz Homepage",
      "method": "GET",
      "url": "http://realtutorialhub-quiz:3001/",
      "expected_status": 200,
      "timeout_seconds": 15,
      "required": true
    },
    "realtutorialhub-admin": {
      "name": "RTH Admin Health",
      "method": "GET",
      "url": "http://realtutorialhub-admin:3002/api/healthz",
      "expected_status": 200,
      "timeout_seconds": 15,
      "required": true
    },
    "skillup-web": {
      "name": "SkillUp Web Health",
      "method": "GET",
      "url": "http://skillup-web:3004/api/healthz",
      "expected_status": 200,
      "timeout_seconds": 10,
      "required": true
    },
    "skillup-admin": {
      "name": "SkillUp Admin Health",
      "method": "GET",
      "url": "http://skillup-admin:3005/api/healthz",
      "expected_status": 200,
      "timeout_seconds": 15,
      "required": true
    },
    "faculty-app": {
      "name": "Faculty App Health",
      "method": "GET",
      "url": "http://faculty-app:3006/api/healthz",
      "expected_status": 200,
      "timeout_seconds": 15,
      "required": true
    },
    "skillhubcore-admin": {
      "name": "SkillHub Core Admin Health",
      "method": "GET",
      "url": "http://skillhubcore-admin:3000/api/health",
      "expected_status": 200,
      "timeout_seconds": 15,
      "required": true
    },
    "skillhub-placement": {
      "name": "SkillHub Placement Health",
      "method": "GET",
      "url": "http://skillhub-placement:3008/api/healthz",
      "expected_status": 200,
      "timeout_seconds": 15,
      "required": false
    },
    "skillhubcore-service": {
      "name": "SkillHub Core Service Health",
      "method": "GET",
      "url": "http://skillhubcore-service:3000/healthz/",
      "expected_status": 200,
      "timeout_seconds": 10,
      "required": true
    }
  }
}
