  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
