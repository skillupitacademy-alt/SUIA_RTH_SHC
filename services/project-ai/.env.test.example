# Test Environment Configuration for Project AI Service
#
# Copy this file to .env.test for local integration testing:
#   cp .env.test.example .env.test
#
# These values match the docker-compose.test-db.yml configuration.

# Test Database Connection
# Uses port 55432 to avoid conflict with host PostgreSQL (typically on 5432)
TEST_DATABASE_URL_TUTORIAL=postgresql+asyncpg://test_user:test_password@localhost:55432/tutorial_test

# JWT Secrets (Test Values Only - Never Use in Production)
# Minimum 32 characters required for HS256 algorithm
JWT_SECRET=test_jwt_secret_minimum_32_characters_long_value
ADMIN_JWT_SECRET=test_admin_jwt_secret_minimum_32_characters

# Optional: JWT Configuration
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
