# Install as /opt/platform/env/project-ai/worker.env (owned by UID 1000, mode 0600).
# Never put this file's real values in Git or in Docker build arguments.
DATABASE_URL_TUTORIAL=postgresql://REPLACE_WORKFLOW_DATABASE
JWT_SECRET=REPLACE_WITH_THE_LEARNER_API_SIGNING_SECRET
ADMIN_JWT_SECRET=REPLACE_WITH_THE_ADMIN_LOGIN_SIGNING_SECRET
INTERNAL_API_SECRET=REPLACE_WITH_THE_API_SERVER_INTERNAL_SECRET
INTERNAL_API_KEY=REPLACE_WITH_THE_API_SERVER_INTERNAL_KEY
PROJECT_LLM_EXECUTION_MODE=isolated_worker
PROJECT_LLM_LEARNER_RUNTIME_ENABLED=true
PROJECT_LLM_FIXTURE_DATABASE_WRITES_ALLOWED=true
PROJECT_LLM_VERIFICATION_DATABASE_URL=postgresql://REPLACE_APPROVED_FIXTURE_DATABASE
PROJECT_LLM_LEARNER_API_BASE_URL=http://api-server:3000/api
INTERNAL_API_URL=http://api-server:3000/api
GATEWAY_URL=http://api-server:3000/api
PROJECT_LLM_FIXTURE_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PROJECT_LLM_TEST_TENANT=skillup
PROJECT_LLM_LEARNER_TEST_TENANT=skillup
PROJECT_LLM_TEST_FIXTURE_IDS=project-llm-learner-runtime
PROJECT_LLM_LEARNER_TEST_FIXTURE_ID=project-llm-learner-runtime
PROJECT_LLM_TEST_LEARNER_ID=REPLACE_WITH_SETUP_GENERATED_UUID
PROJECT_LLM_LEARNER_FIXTURE_CATALOG_PATH=/etc/project-ai/learner-fixtures.json
