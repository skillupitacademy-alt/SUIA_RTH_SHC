{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2020",
        "baseUrl": ".",
        "module": "ESNext",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "incremental": true,
        "paths": {
            "@quiz/db": [
                "./packages/db/src/index.ts"
            ],
            "@quiz/db/*": [
                "./packages/db/src/*"
            ],
            "@quiz/api-client": [
                "./packages/api-client/src/index.ts"
            ],
            "@quiz/api-client/*": [
                "./packages/api-client/src/*"
            ],
            "@quiz/config": [
                "./packages/config/envPaths.ts"
            ],
            "@quiz/config/*": [
                "./packages/config/*"
            ],
            "@quiz/ui": [
                "./packages/ui/src/index.ts"
            ],
            "@quiz/types": [
                "./packages/types/src/index.ts"
            ],
            "@quiz/types/*": [
                "./packages/types/src/*"
            ],
            "@quiz/observability": [
                "./packages/observability/src/index.ts"
            ],
            "@/*": [
                "./apps/web-app/src/*",
                "./apps/admin-app/src/*",
                "./apps/api-server/src/*",
                "./packages/ui/src/*"
            ],
            "@tests/*": [
                "./tests/*"
            ]
        },
        "noEmit": true
    },
    "exclude": [
        "node_modules",
        "dist",
        "build",
        ".next",
        "**/*.config.js",
        "**/*.config.mjs"
    ],
    "include": [
        "packages/types/src/globals/**/*.d.ts",
        "apps",
        "packages",
        "tests"
    ]
}